{
  "name": "@sip01/protocol",
  "version": "2.0.0",
  "license": "MIT",
  "description": "SIP-01 (Search Index Protocol) v1.2 wire-format reference: kind 39697 web-index observation build/parse/verify, indexer identity, relay discovery — vendored byte-verbatim from sip-01-core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/relayValidator.d.ts",
      "import": "./dist/conformance/relayValidator.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nostrify/nostrify": "^0.52.2",
    "nostr-tools": "^2.23.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "jsdom": "^29.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
